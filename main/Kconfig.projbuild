menu "OpenThread Border Router Example"

    config OPENTHREAD_SUPPORT_HW_RESET_RCP
        bool 'Enable hardware RCP resetting'
        default n
        help
            If enabled, the Thread Border Router will support hardware resetting the RCP
            when processing RCP failure.

    config OPENTHREAD_HW_RESET_RCP_PIN
        int 'Pin to RCP reset'
        depends on OPENTHREAD_SUPPORT_HW_RESET_RCP
        default 7

endmenu

menu "Matter2Supla"

    config M2S_MATTER_CONTROLLER_AUTOSTART
        bool "EXPERIMENTAL: start Matter Controller (NVS/Wi-Fi risk)"
        depends on ESP_MATTER_CONTROLLER_ENABLE && ESP_MATTER_COMMISSIONER_ENABLE
        default n
        help
            Keep disabled until NVS backup and Wi-Fi coexistence are verified.

    config M2S_MATTER_CONTROLLER_MANUAL_CLI
        bool "EXPERIMENTAL: manual Matter Controller CLI start"
        depends on ESP_MATTER_CONTROLLER_ENABLE && ESP_MATTER_COMMISSIONER_ENABLE && OPENTHREAD_CLI
        default n
        help
            Register a serial CLI command. Starting Matter may write CHIP data to NVS.

endmenu
