class M2sIkeaTrustStore final : public chip::Credentials::AttestationTrustStore {
public:
    CHIP_ERROR GetProductAttestationAuthorityCert(
        const chip::ByteSpan &skid,
        chip::MutableByteSpan &output) const override
    {
        if (!skid.data_equal(chip::ByteSpan(kM2sIkeaSkid, sizeof(kM2sIkeaSkid)))) {
            return CHIP_ERROR_CA_CERT_NOT_FOUND;
        }
        return chip::CopySpanToMutableSpan(
            chip::ByteSpan(kM2sIkeaPaa, sizeof(kM2sIkeaPaa)), output);
    }
};

void m2s_install_ikea_paa()
{
    static M2sIkeaTrustStore store;
    chip::Credentials::set_custom_attestation_trust_store(&store);
    ESP_LOGI("M2S_PAA", "IKEA production PAA installed; VID=0x117C");
}
